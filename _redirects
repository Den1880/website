# Den 1880 — 301 redirects from the old Squarespace site to the new Netlify site.
# Built from the old Squarespace sitemap (ranunculus-capybera-sp5g.squarespace.com).
# Goal: every old indexed URL lands on the closest relevant new page (preserves SEO).
# www -> non-www is handled automatically by Netlify, so no rule is needed for that.
# Netlify matches the FIRST rule that applies, so specific rules are listed before wildcards.

# -- Gallery: the gallery/ folder of use-case pages would otherwise make the
# bare trailing-slash URL a 404 (there is no gallery/index.html; /gallery is
# served by gallery.html via pretty URLs).
/gallery/                   /gallery        301

# -- Memberships (coworking / resident desk / day passes) --
/club-membership            /memberships    301
/club-membership-1          /memberships    301
/club-membership-2          /memberships    301
/residentdesk               /memberships    301
/residentdesk-1             /memberships    301
/day-passes                 /day-pass       301
/day-passes-1               /day-pass       301

# -- Teams / corporate (offices, solutions, meeting rooms) --
/business-solutions         /corporate/     301
/solutions                  /corporate/     301

# -- Business address / virtual mail (maps to the new business-mail pages) --
/business-address           /business-mail              301
/virtualmail-application     /business-mail-application  301
/termsandconditionsvirtualmail  /business-mail-terms    301

# -- Performance Club (now its own site) --
/performance-club           https://performanceclub.ca/  301

# -- Old events pages -> new private-events venue page --
/eventsatden                /private-events 301
/eventsatden/*              /private-events 301
/events                     /private-events 301
# NOTE: private-events, weddings, holiday-parties, team-offsites,
# and eventinquiry are now real rebuilt pages -- no redirect needed.

# /weddings is a directory (weddings/index.html). Without this, the
# extensionless form returns a bare "Document moved permanently" body
# instead of a clean 301 to the trailing-slash URL.
/weddings                   /weddings/      301!

# -- event-inquiry-success retired Sept 2026: it was the Netlify thank-you
# for the old event-inquiry and day-pass forms. Both now use embedded
# HoneyBook / Optix widgets that confirm inline, so nothing reaches it.
# Redirect rather than 404 in case it is indexed.
/event-inquiry-success      /eventinquiry   301

# -- bookanevent retired Aug 2026: it was an orphaned duplicate of the
# private-events "Find Your Event" hub (same hub grid, but nothing on the
# site linked to it and its hub grid never got the newer sitelink pages
# added). Nothing internal pointed here, but it was in sitemap.xml so it
# may be indexed -- redirect preserves anyone who lands on it from search.
/bookanevent                /private-events 301
/bookanevent.html           /private-events 301

# -- corporate/team-office and corporate/community retired Aug 2026: both
# were bare click-through stub pages ("Redirecting to X..."), not real
# content. team-office.html was still linked from 4 sibling corporate
# pages (compare/drop-in/enterprise/faq) via a "Team Office" sub-nav
# link -- those 4 links now point straight to /private-offices (the
# stub's own stated redirect target) instead of through the stub.
# community.html had no inbound links from anywhere on the site.
/corporate/team-office       /private-offices 301
/corporate/team-office.html  /private-offices 301
/corporate/community         /                301
/corporate/community.html    /                301

